# Dependencies
node_modules/
package-lock.json

# Environment files (contain secrets!)
.env
.env.local
.env.*.local

# Timestamped backups. These rules existed for .env but not for the .env.bak-*
# files that the auth and config tooling leaves behind, so a stray `git add -A`
# would have published DRACHTIO_SECRET, FREESWITCH_SECRET and the SIP trunk
# config. The parent PAI repo has carried this rule since its own near-miss.
*.bak
*.bak-*
*.backup

# Credentials directory (contains API keys and secrets!)
.credentials/

# Generated audio files
voice-app/audio/*.mp3
voice-app/audio/*.wav
claude-api-server/audio/

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
.docker/

# Temporary files
tmp/
temp/
*.tmp

# Certificates (if any)
*.pem
*.key
*.crt
*.pfx

# Test thumbnails from development
*.jpg
*.png
!docs/*.png
!docs/*.jpg
!assets/*.png
!assets/*.jpg
voice-app/config/devices.json

# Bun lockfile. This repo keeps lockfiles out of git entirely (see
# package-lock.json above); a second one would only create drift. Added 2026-08-10.
bun.lock

# Live call database plus its WAL and SHM sidecars. Runtime state, not source:
# 4.9 MB and growing, rewritten on every call. Added 2026-08-10.
voice-app/data/
